# Environment Configuration for joe-whatsapp-bot
# Copy this file to .env and fill in your values

# ============================================================
# REQUIRED: Your WhatsApp Phone Number (with country code)
# ============================================================
# Format: country code + number, no spaces or dashes
# Example: 5511999998888 (Brazil), 14155551234 (USA)
OWNER_PHONE=

# ============================================================
# AI PROVIDER: Gemini API (Cloud - Recommended)
# ============================================================
# Get your free API key at: https://aistudio.google.com/apikey
# Leave empty to use Ollama local only
GEMINI_API_KEY=

# ============================================================
# AI PROVIDER: Ollama (Local - Optional)
# ============================================================
# Install Ollama from: https://ollama.ai
# Default model: gemma2 (or any model you have installed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# ============================================================
# BOT PERSONALITY (Optional)
# ============================================================
# Name the bot uses to refer to itself
BOT_NAME=Joe
# How the bot addresses the user
USER_TITLE=
# Custom system prompt (leave empty for default)
BOT_SYSTEM_PROMPT=

# ============================================================
# TEXT-TO-SPEECH (Optional)
# ============================================================
# TTS engine: "edge-tts" (free, cloud) or "voicebox" (local)
TTS_ENGINE=edge-tts
# Voice for edge-tts (see: https://speech.platform.bing.com/consumer/speech/synthesize/readaloud/voices/list?trustedclienttoken=6A5AA1D4EAFF4E9FB37E23D68491D6F4)
TTS_VOICE=en-US-GuyNeural
# Voicebox URL (only if TTS_ENGINE=voicebox)
VOICEBOX_URL=http://127.0.0.1:17493

# ============================================================
# TRANSCRIPTION (Optional)
# ============================================================
# Transcription engine: "gemini" (cloud), "voicebox" (local), "whisper" (local)
# Falls back automatically: gemini -> voicebox -> whisper
TRANSCRIPTION_ENGINE=gemini

# ============================================================
# TUNNEL / REMOTE ACCESS (Optional)
# ============================================================
# Port to expose via Cloudflare Tunnel (default: 8080)
TUNNEL_PORT=8080
